{
  "name": "@clarifi/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest --config ./jest.config.ts",
    "signal:backtest": "ts-node scripts/signal-backtest.ts",
    "scrape": "ts-node --project tsconfig.json scripts/scrapers/run-all.ts",
    "scrape:lotus": "ts-node --project tsconfig.json scripts/scrapers/lotus.scraper.ts",
    "scrape:aeon": "ts-node --project tsconfig.json scripts/scrapers/aeon.scraper.ts",
    "scrape:jaya-grocer": "ts-node --project tsconfig.json scripts/scrapers/jaya-grocer.scraper.ts",
    "scrape:nsk": "ts-node --project tsconfig.json scripts/scrapers/nsk.scraper.ts",
    "scrape:playwright": "ts-node --project tsconfig.json scripts/scrapers/playwright-scraper.ts",
    "ingest": "ts-node --project tsconfig.json scripts/scrapers/ingest.ts",
    "ingest:lotus": "ts-node --project tsconfig.json scripts/scrapers/ingest.ts --store lotus",
    "ingest:jaya-grocer": "ts-node --project tsconfig.json scripts/scrapers/ingest.ts --store jaya_grocer",
    "scrape:and:ingest": "ts-node --project tsconfig.json scripts/scrapers/lotus.scraper.ts && ts-node --project tsconfig.json scripts/scrapers/jaya-grocer.scraper.ts && ts-node --project tsconfig.json scripts/scrapers/ingest.ts",
    "seed:demo": "ts-node --project tsconfig.json prisma/seed.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@clarifi/shared": "workspace:*",
    "@clerk/backend": "^3.0.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@prisma/client": "^5.21.1",
    "@supabase/supabase-js": "^2.98.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cron": "^3.2.1",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "prisma": "^5.21.1",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
