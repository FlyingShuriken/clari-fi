generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseSource {
  VOICE
  RECEIPT
  MANUAL
}

enum ExpenseProvenance {
  VOICE_ON_DEVICE
  VOICE_CLOUD
  RECEIPT_OCR
  MANUAL
}

enum PaymentMethodType {
  CASH
  CARD
  BANK_TRANSFER
  E_WALLET
  TNG
  GRABPAY
  SHOPEEPAY
  DUITNOW
  OTHER
}

enum CurrencyCode {
  MYR
  SGD
  USD
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum StoreProvider {
  OSM_NOMINATIM
}

enum PromoReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ObservationSource {
  EXPENSE
  PROMO
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  displayName String?
  locale      String   @default("en-MY")
  timezone    String   @default("Asia/Kuala_Lumpur")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses          Expense[]
  receipts          Receipt[]
  reports           MonthlyReport[]
  priceObservations PriceObservation[]
  priceAlerts       PriceAlert[]
  alertEvents       AlertEvent[]
  promoIngestions   PromoIngestion[]
  promoObservations PromoObservation[]
}

model Expense {
  id                 String            @id @default(cuid())
  userId             String
  source             ExpenseSource
  provenance         ExpenseProvenance @default(VOICE_ON_DEVICE)
  currency           CurrencyCode      @default(MYR)
  totalAmount        Decimal           @db.Decimal(12, 2)
  merchantText       String?
  paymentMethod      PaymentMethodType?
  transactionAt      DateTime
  locationLat        Decimal?          @db.Decimal(10, 7)
  locationLng        Decimal?          @db.Decimal(10, 7)
  areaText           String?
  note               String?
  confidence         Decimal?          @db.Decimal(5, 4)
  parseLatencyMs     Int?
  requiresCorrection Boolean           @default(false)
  rawPayload         Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lineItems ExpenseLineItem[]
  receipt   Receipt?
  priceObservations PriceObservation[]

  @@index([userId, transactionAt])
  @@index([provenance, transactionAt])
}

model ExpenseLineItem {
  id             String       @id @default(cuid())
  expenseId      String
  descriptionRaw String
  quantity       Decimal?     @db.Decimal(12, 4)
  unitRaw        String?
  unitPrice      Decimal?     @db.Decimal(12, 2)
  totalPrice     Decimal      @db.Decimal(12, 2)
  currency       CurrencyCode @default(MYR)
  confidence     Decimal?     @db.Decimal(5, 4)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  priceObservation PriceObservation?

  @@index([expenseId])
}

model Receipt {
  id            String           @id @default(cuid())
  userId        String
  expenseId     String?          @unique
  fileRef       String
  mimeType      String
  ocrStatus     ProcessingStatus @default(COMPLETED)
  ocrRaw        Json?
  parsedPayload Json?
  confidence    Decimal?         @db.Decimal(5, 4)
  capturedAt    DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([userId, capturedAt])
}

model MonthlyReport {
  id                String   @id @default(cuid())
  userId            String
  year              Int
  month             Int
  cashIn            Decimal  @default(0) @db.Decimal(12, 2)
  cashOut           Decimal  @default(0) @db.Decimal(12, 2)
  netCashFlow       Decimal  @default(0) @db.Decimal(12, 2)
  categoryBreakdown Json?
  insights          Json?
  generatedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

model CanonicalItem {
  id            String   @id @default(cuid())
  canonicalName String   @unique
  canonicalUnit String?
  category      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases           ItemAlias[]
  observations      PriceObservation[]
  priceAlerts       PriceAlert[]
  promoObservations PromoObservation[]
  alertEvents       AlertEvent[]
}

model ItemAlias {
  id              String   @id @default(cuid())
  canonicalItemId String
  aliasText       String
  locale          String   @default("und")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  canonicalItem CanonicalItem @relation(fields: [canonicalItemId], references: [id], onDelete: Cascade)

  @@unique([aliasText, locale])
  @@index([canonicalItemId])
}

model Store {
  id             String        @id @default(cuid())
  displayName    String
  normalizedName String
  provider       StoreProvider @default(OSM_NOMINATIM)
  providerPlaceId String?
  lat            Decimal?      @db.Decimal(10, 7)
  lng            Decimal?      @db.Decimal(10, 7)
  address        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  observations      PriceObservation[]
  promoObservations PromoObservation[]
  priceAlerts       PriceAlert[]
  alertEvents       AlertEvent[]

  @@unique([provider, providerPlaceId])
  @@index([normalizedName])
}

model PriceObservation {
  id                String            @id @default(cuid())
  userId            String
  expenseId         String
  expenseLineItemId String            @unique
  canonicalItemId   String
  storeId           String?
  areaText          String?
  currency          CurrencyCode      @default(MYR)
  quantity          Decimal?          @db.Decimal(12, 4)
  unitRaw           String?
  unitPrice         Decimal           @db.Decimal(12, 2)
  totalPrice        Decimal           @db.Decimal(12, 2)
  observedAt        DateTime
  provenance        ExpenseProvenance
  trustScore        Decimal           @db.Decimal(5, 4)
  outlierFlag       Boolean           @default(false)
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense       Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseLineItem ExpenseLineItem @relation(fields: [expenseLineItemId], references: [id], onDelete: Cascade)
  canonicalItem CanonicalItem @relation(fields: [canonicalItemId], references: [id], onDelete: Restrict)
  store         Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([canonicalItemId, observedAt])
  @@index([storeId, canonicalItemId, observedAt])
  @@index([areaText, canonicalItemId, observedAt])
}

model PriceAlert {
  id              String   @id @default(cuid())
  userId          String
  canonicalItemId String
  storeId         String?
  areaText        String?
  targetUnitPrice Decimal  @db.Decimal(12, 2)
  radiusKm        Decimal  @default(10) @db.Decimal(7, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalItem CanonicalItem @relation(fields: [canonicalItemId], references: [id], onDelete: Restrict)
  store         Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  events        AlertEvent[]

  @@index([userId, active])
  @@index([canonicalItemId, active])
  @@index([storeId, active])
}

model AlertEvent {
  id              String            @id @default(cuid())
  alertId          String
  userId           String
  canonicalItemId  String
  storeId          String?
  areaText         String?
  source           ObservationSource @default(EXPENSE)
  triggerUnitPrice Decimal           @db.Decimal(12, 2)
  targetUnitPrice  Decimal           @db.Decimal(12, 2)
  distanceKm       Decimal?          @db.Decimal(7, 2)
  payload          Json?
  readAt           DateTime?
  triggeredAt      DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  alert         PriceAlert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalItem CanonicalItem @relation(fields: [canonicalItemId], references: [id], onDelete: Restrict)
  store         Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([userId, triggeredAt])
  @@index([alertId, triggeredAt])
  @@index([readAt])
}

model PromoIngestion {
  id            String           @id @default(cuid())
  userId        String
  fileRef       String
  mimeType      String
  merchantText  String?
  areaText      String?
  status        ProcessingStatus @default(PENDING)
  rawText       String?
  ocrRaw        Json?
  parsedPayload Json?
  errorText     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  observations PromoObservation[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PromoObservation {
  id              String            @id @default(cuid())
  ingestionId     String
  userId          String
  canonicalItemId String
  storeId         String?
  areaText        String?
  currency        CurrencyCode      @default(MYR)
  quantity        Decimal?          @db.Decimal(12, 4)
  unitRaw         String?
  unitPrice       Decimal           @db.Decimal(12, 2)
  totalPrice      Decimal?          @db.Decimal(12, 2)
  trustScore      Decimal           @db.Decimal(5, 4)
  reviewStatus    PromoReviewStatus @default(PENDING)
  observedAt      DateTime          @default(now())
  validFrom       DateTime?
  validTo         DateTime?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  ingestion     PromoIngestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalItem CanonicalItem  @relation(fields: [canonicalItemId], references: [id], onDelete: Restrict)
  store         Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([canonicalItemId, observedAt])
  @@index([reviewStatus, validFrom, validTo])
  @@index([storeId, canonicalItemId, observedAt])
  @@index([areaText, canonicalItemId, observedAt])
}
