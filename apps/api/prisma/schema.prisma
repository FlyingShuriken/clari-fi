generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseSource {
  VOICE
  RECEIPT
  MANUAL
}

enum ExpenseProvenance {
  VOICE_ON_DEVICE
  VOICE_CLOUD
  RECEIPT_OCR
  MANUAL
}

enum PaymentMethodType {
  CASH
  CARD
  BANK_TRANSFER
  E_WALLET
  TNG
  GRABPAY
  SHOPEEPAY
  DUITNOW
  OTHER
}

enum CurrencyCode {
  MYR
  SGD
  USD
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  displayName String?
  locale      String   @default("en-MY")
  timezone    String   @default("Asia/Kuala_Lumpur")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses Expense[]
  receipts Receipt[]
  reports  MonthlyReport[]
}

model Expense {
  id                 String            @id @default(cuid())
  userId             String
  source             ExpenseSource
  provenance         ExpenseProvenance @default(VOICE_ON_DEVICE)
  currency           CurrencyCode      @default(MYR)
  totalAmount        Decimal           @db.Decimal(12, 2)
  merchantText       String?
  paymentMethod      PaymentMethodType?
  transactionAt      DateTime
  note               String?
  confidence         Decimal?          @db.Decimal(5, 4)
  parseLatencyMs     Int?
  requiresCorrection Boolean           @default(false)
  rawPayload         Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lineItems ExpenseLineItem[]
  receipt   Receipt?

  @@index([userId, transactionAt])
  @@index([provenance, transactionAt])
}

model ExpenseLineItem {
  id             String       @id @default(cuid())
  expenseId      String
  descriptionRaw String
  quantity       Decimal?     @db.Decimal(12, 4)
  unitRaw        String?
  unitPrice      Decimal?     @db.Decimal(12, 2)
  totalPrice     Decimal      @db.Decimal(12, 2)
  currency       CurrencyCode @default(MYR)
  confidence     Decimal?     @db.Decimal(5, 4)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model Receipt {
  id            String           @id @default(cuid())
  userId        String
  expenseId     String?          @unique
  fileRef       String
  mimeType      String
  ocrStatus     ProcessingStatus @default(COMPLETED)
  ocrRaw        Json?
  parsedPayload Json?
  confidence    Decimal?         @db.Decimal(5, 4)
  capturedAt    DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([userId, capturedAt])
}

model MonthlyReport {
  id                String   @id @default(cuid())
  userId            String
  year              Int
  month             Int
  cashIn            Decimal  @default(0) @db.Decimal(12, 2)
  cashOut           Decimal  @default(0) @db.Decimal(12, 2)
  netCashFlow       Decimal  @default(0) @db.Decimal(12, 2)
  categoryBreakdown Json?
  insights          Json?
  generatedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId, year, month])
}
