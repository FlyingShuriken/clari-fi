generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseSource {
  VOICE
  RECEIPT
  MANUAL
}

enum ExpenseProvenance {
  VOICE_ON_DEVICE
  VOICE_CLOUD
  RECEIPT_OCR
  MANUAL
}

enum PaymentMethodType {
  CASH
  CARD
  BANK_TRANSFER
  E_WALLET
  TNG
  GRABPAY
  SHOPEEPAY
  DUITNOW
  OTHER
}

enum CurrencyCode {
  MYR
  SGD
  USD
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum StoreProvider {
  OSM_NOMINATIM
}

enum PromoReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ObservationSource {
  EXPENSE
  PROMO
}

enum AlertKind {
  THRESHOLD
  SIGNAL
}

enum SignalDecisionFilter {
  BUY_NOW
  WAIT
  BOTH
}

enum FamilyRole {
  OWNER
  EDITOR
  VIEWER
}

enum FamilyMemberStatus {
  ACTIVE
  REMOVED
}

enum FamilyInviteStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

enum SplitStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum SplitParticipantType {
  MEMBER
  GUEST
}

enum SplitAllocationType {
  ITEM
  SHARED_CHARGE
}

enum SettlementStatus {
  PENDING
  SETTLED
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  displayName String?
  locale      String   @default("en-MY")
  timezone    String   @default("Asia/Kuala_Lumpur")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses          Expense[]
  receipts          Receipt[]
  reports           MonthlyReport[]
  priceObservations PriceObservation[]
  priceAlerts       PriceAlert[]
  alertEvents       AlertEvent[]
  promoIngestions   PromoIngestion[]
  promoObservations PromoObservation[]
  pushDevices       PushDevice[]
  createdFamilies      FamilyProfile[]
  familyMemberships    FamilyMember[]
  familyInvitesCreated FamilyInvite[]  @relation("FamilyInviteCreatedBy")
  familyInvitesUsed    FamilyInvite[]  @relation("FamilyInviteUsedBy")
  splitSessionsCreated SplitSession[]
  subscription         UserSubscription?
  subscriptionUsage    SubscriptionUsageMonth[]
}

model UserSubscription {
  id         String           @id @default(cuid())
  userId     String           @unique
  plan       SubscriptionPlan @default(FREE)
  addonCount Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubscriptionUsageMonth {
  id                 String   @id @default(cuid())
  userId             String
  periodKey          String
  compareSearchCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@index([userId, periodKey])
}

model Expense {
  id                 String            @id @default(cuid())
  userId             String
  familyId           String?
  source             ExpenseSource
  provenance         ExpenseProvenance @default(VOICE_ON_DEVICE)
  currency           CurrencyCode      @default(MYR)
  totalAmount        Decimal           @db.Decimal(12, 2)
  merchantText       String?
  paymentMethod      PaymentMethodType?
  transactionAt      DateTime
  locationLat        Decimal?          @db.Decimal(10, 7)
  locationLng        Decimal?          @db.Decimal(10, 7)
  areaText           String?
  note               String?
  confidence         Decimal?          @db.Decimal(5, 4)
  parseLatencyMs     Int?
  requiresCorrection Boolean           @default(false)
  rawPayload         Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  family           FamilyProfile?     @relation(fields: [familyId], references: [id], onDelete: SetNull)
  lineItems        ExpenseLineItem[]
  receipt          Receipt?
  priceObservations PriceObservation[]
  splitSessions    SplitSession[]

  @@index([userId, transactionAt])
  @@index([familyId, transactionAt])
  @@index([provenance, transactionAt])
}

model ExpenseLineItem {
  id             String       @id @default(cuid())
  expenseId      String
  descriptionRaw String
  quantity       Decimal?     @db.Decimal(12, 4)
  unitRaw        String?
  unitPrice      Decimal?     @db.Decimal(12, 2)
  totalPrice     Decimal      @db.Decimal(12, 2)
  currency       CurrencyCode @default(MYR)
  confidence     Decimal?     @db.Decimal(5, 4)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  priceObservation PriceObservation?
  splitAllocations SplitAllocation[]

  @@index([expenseId])
}

model Receipt {
  id            String           @id @default(cuid())
  userId        String
  expenseId     String?          @unique
  fileRef       String
  mimeType      String
  ocrStatus     ProcessingStatus @default(COMPLETED)
  ocrRaw        Json?
  parsedPayload Json?
  confidence    Decimal?         @db.Decimal(5, 4)
  capturedAt    DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([userId, capturedAt])
}

model MonthlyReport {
  id                String   @id @default(cuid())
  userId            String
  year              Int
  month             Int
  cashIn            Decimal  @default(0) @db.Decimal(12, 2)
  cashOut           Decimal  @default(0) @db.Decimal(12, 2)
  netCashFlow       Decimal  @default(0) @db.Decimal(12, 2)
  categoryBreakdown Json?
  insights          Json?
  generatedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

model FamilyProfile {
  id              String   @id @default(cuid())
  name            String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  members   FamilyMember[]
  invites   FamilyInvite[]
  expenses  Expense[]
  splits    SplitSession[]

  @@index([createdByUserId, createdAt])
}

model FamilyMember {
  id        String             @id @default(cuid())
  familyId  String
  userId    String
  role      FamilyRole         @default(VIEWER)
  status    FamilyMemberStatus @default(ACTIVE)
  joinedAt  DateTime           @default(now())
  removedAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  family FamilyProfile @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  splitParticipants SplitParticipant[]

  @@unique([familyId, userId])
  @@index([userId, status])
  @@index([familyId, status])
}

model FamilyInvite {
  id              String           @id @default(cuid())
  familyId        String
  code            String           @unique
  createdByUserId String
  usedByUserId    String?
  status          FamilyInviteStatus @default(ACTIVE)
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  family    FamilyProfile @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User          @relation("FamilyInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  usedBy    User?         @relation("FamilyInviteUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([familyId, status, expiresAt])
  @@index([createdByUserId, createdAt])
}

model SplitSession {
  id              String      @id @default(cuid())
  familyId        String
  createdByUserId String
  expenseId       String?
  title           String?
  currency        CurrencyCode @default(MYR)
  subtotal        Decimal     @default(0) @db.Decimal(12, 2)
  sharedCharge    Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @default(0) @db.Decimal(12, 2)
  status          SplitStatus @default(DRAFT)
  finalizedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  family    FamilyProfile @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  expense   Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  participants SplitParticipant[]
  allocations  SplitAllocation[]
  settlements  SplitSettlement[]

  @@index([familyId, status, createdAt])
  @@index([expenseId])
}

model SplitParticipant {
  id             String               @id @default(cuid())
  splitId        String
  familyMemberId String?
  type           SplitParticipantType @default(MEMBER)
  displayName    String
  isPayer        Boolean              @default(false)
  paidAmount     Decimal              @default(0) @db.Decimal(12, 2)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  split       SplitSession   @relation(fields: [splitId], references: [id], onDelete: Cascade)
  familyMember FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  allocations SplitAllocation[]
  settlementsFrom SplitSettlement[] @relation("SplitSettlementFrom")
  settlementsTo   SplitSettlement[] @relation("SplitSettlementTo")

  @@index([splitId])
  @@index([familyMemberId])
}

model SplitAllocation {
  id                String              @id @default(cuid())
  splitId           String
  participantId     String
  expenseLineItemId String?
  allocationType    SplitAllocationType @default(ITEM)
  lineItemLabel     String?
  amount            Decimal             @db.Decimal(12, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  split         SplitSession     @relation(fields: [splitId], references: [id], onDelete: Cascade)
  participant   SplitParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  expenseLineItem ExpenseLineItem? @relation(fields: [expenseLineItemId], references: [id], onDelete: SetNull)

  @@index([splitId, participantId])
  @@index([expenseLineItemId])
}

model SplitSettlement {
  id                String          @id @default(cuid())
  splitId           String
  fromParticipantId String
  toParticipantId   String
  amount            Decimal         @db.Decimal(12, 2)
  status            SettlementStatus @default(PENDING)
  settledAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  split          SplitSession     @relation(fields: [splitId], references: [id], onDelete: Cascade)
  fromParticipant SplitParticipant @relation("SplitSettlementFrom", fields: [fromParticipantId], references: [id], onDelete: Cascade)
  toParticipant   SplitParticipant @relation("SplitSettlementTo", fields: [toParticipantId], references: [id], onDelete: Cascade)

  @@index([splitId, status])
  @@index([fromParticipantId])
  @@index([toParticipantId])
}

model CanonicalItem {
  id            String   @id @default(cuid())
  canonicalName String   @unique
  canonicalUnit String?
  category      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases           ItemAlias[]
  observations      PriceObservation[]
  priceAlerts       PriceAlert[]
  promoObservations PromoObservation[]
  alertEvents       AlertEvent[]
}

model ItemAlias {
  id              String   @id @default(cuid())
  canonicalItemId String
  aliasText       String
  locale          String   @default("und")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  canonicalItem CanonicalItem @relation(fields: [canonicalItemId], references: [id], onDelete: Cascade)

  @@unique([aliasText, locale])
  @@index([canonicalItemId])
}

model Store {
  id             String        @id @default(cuid())
  displayName    String
  normalizedName String
  provider       StoreProvider @default(OSM_NOMINATIM)
  providerPlaceId String?
  lat            Decimal?      @db.Decimal(10, 7)
  lng            Decimal?      @db.Decimal(10, 7)
  address        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  observations      PriceObservation[]
  promoObservations PromoObservation[]
  priceAlerts       PriceAlert[]
  alertEvents       AlertEvent[]

  @@unique([provider, providerPlaceId])
  @@index([normalizedName])
}

model PriceObservation {
  id                String            @id @default(cuid())
  userId            String
  expenseId         String
  expenseLineItemId String            @unique
  canonicalItemId   String
  storeId           String?
  areaText          String?
  currency          CurrencyCode      @default(MYR)
  quantity          Decimal?          @db.Decimal(12, 4)
  unitRaw           String?
  unitPrice         Decimal           @db.Decimal(12, 2)
  totalPrice        Decimal           @db.Decimal(12, 2)
  observedAt        DateTime
  provenance        ExpenseProvenance
  trustScore        Decimal           @db.Decimal(5, 4)
  outlierFlag       Boolean           @default(false)
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense       Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseLineItem ExpenseLineItem @relation(fields: [expenseLineItemId], references: [id], onDelete: Cascade)
  canonicalItem CanonicalItem @relation(fields: [canonicalItemId], references: [id], onDelete: Restrict)
  store         Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([canonicalItemId, observedAt])
  @@index([storeId, canonicalItemId, observedAt])
  @@index([areaText, canonicalItemId, observedAt])
}

model PriceAlert {
  id              String   @id @default(cuid())
  userId          String
  canonicalItemId String
  kind            AlertKind @default(THRESHOLD)
  storeId         String?
  areaText        String?
  targetUnitPrice Decimal? @db.Decimal(12, 2)
  radiusKm        Decimal  @default(10) @db.Decimal(7, 2)
  signalDecisionFilter SignalDecisionFilter?
  signalMinConfidence Decimal @default(0.65) @db.Decimal(5, 4)
  signalCooldownMinutes Int @default(360)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalItem CanonicalItem @relation(fields: [canonicalItemId], references: [id], onDelete: Restrict)
  store         Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  events        AlertEvent[]

  @@index([userId, active])
  @@index([kind, active])
  @@index([canonicalItemId, active])
  @@index([storeId, active])
}

model AlertEvent {
  id              String            @id @default(cuid())
  alertId          String
  userId           String
  canonicalItemId  String
  eventKind        AlertKind        @default(THRESHOLD)
  storeId          String?
  areaText         String?
  source           ObservationSource @default(EXPENSE)
  triggerUnitPrice Decimal           @db.Decimal(12, 2)
  targetUnitPrice  Decimal?          @db.Decimal(12, 2)
  distanceKm       Decimal?          @db.Decimal(7, 2)
  payload          Json?
  readAt           DateTime?
  triggeredAt      DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  alert         PriceAlert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalItem CanonicalItem @relation(fields: [canonicalItemId], references: [id], onDelete: Restrict)
  store         Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([userId, triggeredAt])
  @@index([eventKind, triggeredAt])
  @@index([alertId, triggeredAt])
  @@index([readAt])
}

model PromoIngestion {
  id            String           @id @default(cuid())
  userId        String
  fileRef       String
  mimeType      String
  merchantText  String?
  areaText      String?
  status        ProcessingStatus @default(PENDING)
  rawText       String?
  ocrRaw        Json?
  parsedPayload Json?
  errorText     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  observations PromoObservation[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PromoObservation {
  id              String            @id @default(cuid())
  ingestionId     String
  userId          String
  canonicalItemId String
  storeId         String?
  areaText        String?
  currency        CurrencyCode      @default(MYR)
  quantity        Decimal?          @db.Decimal(12, 4)
  unitRaw         String?
  unitPrice       Decimal           @db.Decimal(12, 2)
  totalPrice      Decimal?          @db.Decimal(12, 2)
  trustScore      Decimal           @db.Decimal(5, 4)
  reviewStatus    PromoReviewStatus @default(PENDING)
  observedAt      DateTime          @default(now())
  validFrom       DateTime?
  validTo         DateTime?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  ingestion     PromoIngestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalItem CanonicalItem  @relation(fields: [canonicalItemId], references: [id], onDelete: Restrict)
  store         Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([canonicalItemId, observedAt])
  @@index([reviewStatus, validFrom, validTo])
  @@index([storeId, canonicalItemId, observedAt])
  @@index([areaText, canonicalItemId, observedAt])
}

model PushDevice {
  id            String   @id @default(cuid())
  userId        String
  expoPushToken String   @unique
  platform      String?
  appVersion    String?
  lastSeenAt    DateTime @default(now())
  revokedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}
