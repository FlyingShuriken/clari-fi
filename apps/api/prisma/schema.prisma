generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseSource {
  VOICE
  RECEIPT
  MANUAL
}

enum PaymentMethodType {
  CASH
  CARD
  BANK_TRANSFER
  E_WALLET
  TNG
  GRABPAY
  SHOPEEPAY
  DUITNOW
  OTHER
}

enum CurrencyCode {
  MYR
  SGD
  USD
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id             String          @id @default(cuid())
  supabaseUserId String          @unique
  email          String          @unique
  displayName    String?
  locale         String          @default("en-MY")
  timezone       String          @default("Asia/Kuala_Lumpur")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  expenses       Expense[]
  receipts       Receipt[]
  reports        MonthlyReport[]
}

model Area {
  id          String    @id @default(cuid())
  countryCode String    @default("MY")
  city        String
  district    String?
  name        String
  latitude    Decimal?  @db.Decimal(9, 6)
  longitude   Decimal?  @db.Decimal(9, 6)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stores      Store[]
  expenses    Expense[]

  @@unique([city, district, name], name: "city_district_name")
  @@index([city, district])
}

model Store {
  id             String    @id @default(cuid())
  areaId         String?
  name           String
  normalizedName String
  addressLine    String?
  latitude       Decimal?  @db.Decimal(9, 6)
  longitude      Decimal?  @db.Decimal(9, 6)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  area           Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  expenses       Expense[]

  @@unique([normalizedName, areaId], name: "normalizedName_areaId")
  @@index([areaId, normalizedName])
}

model Receipt {
  id           String            @id @default(cuid())
  userId       String
  expenseId    String?           @unique
  sourceFileUrl String
  mimeType     String
  ocrStatus    ProcessingStatus  @default(PENDING)
  ocrRaw       Json?
  parsedPayload Json?
  confidence   Decimal?          @db.Decimal(5, 4)
  capturedAt   DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense      Expense?          @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  lineItems    ExpenseLineItem[]

  @@index([userId, capturedAt])
}

model Expense {
  id            String             @id @default(cuid())
  userId        String
  source        ExpenseSource
  currency      CurrencyCode       @default(MYR)
  totalAmount   Decimal            @db.Decimal(12, 2)
  merchantText  String?
  storeId       String?
  areaId        String?
  paymentMethod PaymentMethodType?
  transactionAt DateTime
  note          String?
  confidence    Decimal?           @db.Decimal(5, 4)
  rawPayload    Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  store         Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  area          Area?              @relation(fields: [areaId], references: [id], onDelete: SetNull)
  lineItems     ExpenseLineItem[]
  receipt       Receipt?

  @@index([userId, transactionAt])
  @@index([storeId, transactionAt])
}

model ExpenseLineItem {
  id             String       @id @default(cuid())
  expenseId      String
  receiptId      String?
  descriptionRaw String
  quantity       Decimal?     @db.Decimal(12, 4)
  unitRaw        String?
  totalPrice     Decimal      @db.Decimal(12, 2)
  currency       CurrencyCode @default(MYR)
  confidence     Decimal?     @db.Decimal(5, 4)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  expense        Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  receipt        Receipt?     @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([expenseId])
  @@index([receiptId])
}

model MonthlyReport {
  id                String    @id @default(cuid())
  userId            String
  year              Int
  month             Int
  cashIn            Decimal   @default(0) @db.Decimal(12, 2)
  cashOut           Decimal   @default(0) @db.Decimal(12, 2)
  netCashFlow       Decimal   @default(0) @db.Decimal(12, 2)
  categoryBreakdown Json?
  insights          Json?
  generatedAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId, year, month])
}
