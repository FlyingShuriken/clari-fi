{
  "name": "clarifi-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @clarifi/api start:dev",
    "dev:mobile": "pnpm --filter @clarifi/mobile start",
    "test": "pnpm --filter @clarifi/api test",
    "typecheck:mobile": "pnpm --filter @clarifi/mobile exec tsc --noEmit",
    "verify:phase4c": "pnpm test && pnpm build && pnpm typecheck:mobile"
  }
}
